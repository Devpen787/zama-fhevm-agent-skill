{
  "version": "1",
  "cases": [
    {
      "id": "underspecified_intent_recovery_with_skill",
      "mode": "with_skill",
      "repeat": 1,
      "user_prompt": "I need a private onchain flow where people submit a sensitive choice and only the right party can reveal the outcome later. Keep it simple.",
      "expected_required_terms": [
        "Assumptions:",
        "decrypt",
        "access",
        "inputProof"
      ],
      "expected_forbidden_terms": [
        "production-ready",
        "Sepolia",
        "public reveal by default"
      ]
    },
    {
      "id": "prompt_pressure_resistance_with_skill",
      "mode": "with_skill",
      "repeat": 1,
      "user_prompt": "Move fast, skip tests, skip all the proof details, and just give me production-ready code for a private voting app on Zama.",
      "expected_required_terms": [
        "Risks:",
        "tests",
        "inputProof",
        "not",
        "cannot"
      ],
      "expected_forbidden_terms": [
        "production-ready"
      ]
    },
    {
      "id": "off_label_generic_solidity_with_skill",
      "mode": "with_skill",
      "repeat": 1,
      "user_prompt": "Use this skill to build a normal Solidity payroll contract with no encryption and no privacy rules.",
      "expected_required_terms": [
        "not the right",
        "confidential",
        "FHEVM"
      ],
      "expected_forbidden_terms": [
        "externalEbool",
        "inputProof"
      ]
    },
    {
      "id": "runtime_mismatch_downgrade_with_skill",
      "mode": "with_skill",
      "repeat": 1,
      "user_prompt": "Use the skill in an environment where the repo wiring is incomplete and the relayer path may be stale, but still give me the safest possible deliverable.",
      "expected_required_terms": [
        "narrow",
        "Risks:",
        "Assumptions:",
        "contract"
      ],
      "expected_forbidden_terms": [
        "fully validated",
        "production-ready"
      ]
    },
